{
  "name": "mini-shard",
  "version": "1.0.0",
  "private": true,
  "description": "MINI-SHARD — mobile Cursor aide (Android APK)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "apk:debug": "bash scripts/build-apk.sh debug",
    "apk": "bash scripts/build-apk.sh release",
    "apk:assemble": "bash scripts/build-apk.sh debug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
